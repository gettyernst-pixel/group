# Copy this file to .streamlit/secrets.toml and paste your own key in.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is listed in .gitignore and must never be committed.
# The app works fully without this file — the Google layer is optional
# enrichment, and everything else runs on NYC public data.
#
# The key needs "Places API (New)" enabled in Google Cloud, and should be
# restricted to that API.
GOOGLE_MAPS_API_KEY = "YOUR_API_KEY_HERE"

# Optional: NYC Open Data app token for the DOT pedestrian-count layer.
# Public reads work without it (throttled harder). Sent as X-App-Token.
NYC_OPEN_DATA_APP_TOKEN = "YOUR_TOKEN_HERE"

# US Census Bureau API key — free at https://api.census.gov/data/key_signup.html
# Needed only by scripts/fetch_acs_nyc.py (the demographics refresh); the app
# itself reads the local CSV that script writes and never calls the Census API.
CENSUS_API_KEY = "YOUR_CENSUS_API_KEY"

# Anthropic API key — used ONLY by the natural-language plan parser on the
# landing page. Claude never scores locations, supplies market facts, or
# generates recommendations; without this key a deterministic parser runs.
ANTHROPIC_API_KEY = "YOUR_ANTHROPIC_API_KEY"
